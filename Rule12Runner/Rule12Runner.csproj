<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>Rule12Runner</ExtensionId>
    <Authors>AEC AB</Authors>
    <Version>0.0.1</Version>
    <Title>Rule12Runner</Title>
    <Description>Registers selected cable tray routes without model changes, exports an Excel queue, and applies confirmed view hiding in a separate batch. BAS Revit 2026 utility, outside the standard rule sequence.</Description>
    <PackageTags>Revit;Assistant;Extension;Automation</PackageTags>
    <MainRevitVersion Condition="'$(Configuration)' == 'Debug'">2026</MainRevitVersion>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <Import Project=".\Configurations.targets" />
  <ItemGroup>
    <Compile Include="..\CSharpRules\Rule12HideDuplicateCableTrays.cs" Link="Rule12HideDuplicateCableTrays.cs" />
    <Compile Include="..\CSharpRules\DrofusRouteQueueStore.cs" Link="DrofusRouteQueueStore.cs" />
    <Compile Include="..\CSharpRules\DrofusRouteQueueRunner.cs" Link="DrofusRouteQueueRunner.cs" />
    <Compile Include="..\CSharpRules\DrofusRouteQueueReport.cs" Link="DrofusRouteQueueReport.cs" />
    <Compile Include="..\CSharpRules\ExcelListReportWriter.cs" Link="ExcelListReportWriter.cs" />
  </ItemGroup>
</Project>