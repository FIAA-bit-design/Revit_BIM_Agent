<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ExtensionId>Rule13Runner</ExtensionId>
    <Authors>AEC AB</Authors>
    <Version>0.0.7</Version>
    <Title>Rule13Runner</Title>
    <Description>Read-only BAS/STA K5B and scoped K5A cabling equipment Excel export, outside the standard BIM sequence.</Description>
    <PackageTags>Revit;Assistant;Extension;Automation</PackageTags>
    <MainRevitVersion>2026</MainRevitVersion>
    <LangVersion>12</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>$(ExtensionId).2026.$(Version)</AssemblyName>
    <PackageId>$(ExtensionId).2026</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2026.0.0" PrivateAssets="all" IncludeAssets="compile" />
    <PackageReference Include="CW.Assistant.Extensions.Revit.2026" Version="26.*" PrivateAssets="all" IncludeAssets="compile" />
    <Compile Include="../CSharpRules/Rule13CablingEquipmentReport.cs" Link="Rule13CablingEquipmentReport.cs" />
    <Compile Include="../CSharpRules/ExcelListReportWriter.cs" Link="ExcelListReportWriter.cs" />
    <Compile Remove="Tests/**/*.cs" />
    <None Include="../config/CablingEquipmentExceptions.json" Link="config/CablingEquipmentExceptions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
